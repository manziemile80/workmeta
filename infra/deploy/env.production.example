# WorkMeta AI — production environment template (copy to infra/.env.production).
# Never commit .env.production. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
APP_NAME=WorkMeta AI API
APP_BASE_URL=https://app.example.com
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=app.example.com,api.example.com
MAX_REQUEST_BODY_BYTES=12582912

POSTGRES_USER=workmeta_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=workmeta
APP_DB_USER=wm_app
APP_DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://wm_app:replace-with-a-long-random-password@db:5432/workmeta
DATABASE_MIGRATION_URL=postgresql+asyncpg://workmeta_owner:replace-with-a-long-random-password@db:5432/workmeta

SESSION_SECRET=replace-with-at-least-32-characters-random-secret
SESSION_TTL_DAYS=7
INVITATION_TTL_DAYS=7

APP_ENV=production
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_RETRY_MAX_BACKOFF_SECONDS=8
CHAT_MAX_OUTPUT_TOKENS=800
AI_SUPPORTED_CHAT_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini

BILLING_PROVIDER=flutterwave
BILLING_CURRENCY=RWF
BILLING_TRIAL_DAYS=14
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_CHECKOUT_CALLBACK_URL=https://app.example.com/billing/checkout
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

STORAGE_BACKEND=local
STORAGE_DIR=/app/var/storage

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_INVITE_ACCEPT_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=120

WORKMETA_VERSION=latest
