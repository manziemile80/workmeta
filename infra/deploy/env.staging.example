# WorkMeta AI — staging environment template (copy to infra/.env.staging).
# Staging uses SANDBOX keys only. Live keys must never appear here.
# NOTE: APP_ENV=test (not production) so the mock provider can be used until
# sandbox keys are mounted; switch to production + a real gateway once the
# release checklist signs off. Never use staging secrets in production.

APP_ENV=test
APP_NAME=WorkMeta AI API (staging)
APP_BASE_URL=http://127.0.0.1:18080
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:18080
ALLOWED_HOSTS=127.0.0.1,localhost,staging.example.com
MAX_REQUEST_BODY_BYTES=12582912

POSTGRES_USER=workmeta_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=workmeta_stage
APP_DB_USER=wm_app
APP_DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://wm_app:replace-with-a-long-random-password@db:5432/workmeta_stage
DATABASE_MIGRATION_URL=postgresql+asyncpg://workmeta_owner:replace-with-a-long-random-password@db:5432/workmeta_stage

SESSION_SECRET=replace-with-at-least-32-characters-random-secret
SESSION_TTL_DAYS=7
SESSION_IDLE_HOURS=8
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
BACKUP_RETENTION_DAYS=30

AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_RETRY_MAX_BACKOFF_SECONDS=8
CHAT_MAX_OUTPUT_TOKENS=800
AI_SUPPORTED_CHAT_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini

# Sandbox gateway (mock until sandbox keys are mounted; see docs/STAGING.md).
BILLING_PROVIDER=mock
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

STORAGE_BACKEND=local
STORAGE_DIR=/app/var/storage

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_INVITE_ACCEPT_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=300
RATE_LIMIT_CHAT_PER_MINUTE=300

WORKMETA_VERSION=latest
