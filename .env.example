# ---------------------------------------------------------------------------
# WorkMeta AI — environment template
# Copy this file to `.env` (never commit `.env`) and replace every placeholder.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Docker Compose creates the owner role and the restricted application role.
POSTGRES_USER=workmeta_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=workmeta
APP_DB_USER=wm_app
APP_DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://wm_app:replace-with-a-long-random-password@127.0.0.1:5432/workmeta
DATABASE_MIGRATION_URL=postgresql+asyncpg://workmeta_owner:replace-with-a-long-random-password@127.0.0.1:5432/workmeta
# A remote database over a slow link needs more than a couple of seconds to
# establish a session, so the timeouts are settings rather than fixed numbers.
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_COMMAND_TIMEOUT_SECONDS=30

# Sessions (server-side opaque tokens; used from Stage 1 onward)
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_DAYS=7
SESSION_IDLE_HOURS=8
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
BACKUP_RETENTION_DAYS=30

# AI provider — SERVER-SIDE ONLY. Never paste this into the extension or web app.
# With AI_API_KEY empty (or AI_PROVIDER=fake) a deterministic offline provider
# is used, so development and tests never call a paid model or the network.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_RETRY_MAX_BACKOFF_SECONDS=8
CHAT_MAX_OUTPUT_TOKENS=800
AI_SUPPORTED_CHAT_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini

# Estimated provider pricing (USD per million tokens) for usage reports only.
AI_CHAT_INPUT_COST_PER_MILLION=0.40
AI_CHAT_OUTPUT_COST_PER_MILLION=1.60
AI_EMBEDDING_COST_PER_MILLION=0.02

# Knowledge ingestion and retrieval (Stage 2, hardened in Stage 3)
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=200
CHUNK_TOKENS=900
CHUNK_OVERLAP_TOKENS=150
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.2
INGESTION_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2

# Optional OCR for images, scanned PDFs and the frames of a screen recording.
#   OCR_ENGINE=rapidocr   ONNX engine; needs nothing installed on the machine
#                          (pip install -e ".[media]")
#   OCR_ENGINE=tesseract  the local Tesseract CLI (+ Pillow, pytesseract and
#                          pypdfium2 for PDF rendering)
#   OCR_ENGINE=auto       whichever of the two is installed
# The default "none" rejects image/scanned-PDF uploads with a clear message.
OCR_ENGINE=none
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
OCR_MAX_IMAGE_PIXELS=40000000
OCR_PDF_DPI=200

# SSE streaming (0 disables heartbeat comments)
STREAM_HEARTBEAT_SECONDS=15

# Billing and subscriptions (Stage 5). Plans themselves are stored in the
# database; these settings only select the provider and lifecycle timing.
# BILLING_PROVIDER must not be "mock" in production. In production configure
# Flutterwave or Paystack and set APP_ENV=production.
BILLING_PROVIDER=mock
BILLING_CURRENCY=RWF
BILLING_TRIAL_DAYS=14
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_CHECKOUT_CALLBACK_URL=http://localhost:5173/billing/checkout
BILLING_MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
BILLING_WEBHOOK_VERIFY=true
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# File storage: local for development, s3 for production
STORAGE_BACKEND=local
STORAGE_DIR=./var/storage

# Security hardening (Stage 6). The reverse proxy is the authoritative
# limiter; these in-app values are a backstop.
ALLOWED_HOSTS=*
MAX_REQUEST_BODY_BYTES=12582912
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=1000
RATE_LIMIT_REGISTER_PER_MINUTE=1000
RATE_LIMIT_INVITE_ACCEPT_PER_MINUTE=1000
RATE_LIMIT_WEBHOOK_PER_MINUTE=1000
RATE_LIMIT_CHAT_PER_MINUTE=1000

# White-label extension signing (Stage 4) and submodel packages (Stage 12).
# The key is Ed25519. It is either a PEM block or "base64:<seed>", and the
# second form is what an .env file can hold on one line.
# Generate one with: python tools/scripts/generate_signing_key.py
EXTENSION_SIGNING_KEY_ID=dev-1
EXTENSION_SIGNING_PRIVATE_KEY=

# Trained extensions (Stage 10). Training material, the procedures extracted
# from it and the permissions of an extension always stay in the client
# organization. See docs/TRAINED_EXTENSIONS.md.
MEDIA_VIDEO_FRAME_INTERVAL_SECONDS=5
MEDIA_VIDEO_MAX_FRAMES=60
EXTENSION_ANALYSIS_MAX_CHARACTERS=120000
EXTENSION_ANALYSIS_MAX_OUTPUT_TOKENS=6000
# Speech-to-text for audio training instructions. Empty means the deployment
# cannot transcribe audio and says so instead of guessing.
AI_TRANSCRIPTION_MODEL=

# First-run platform owner (Stage 1)
SEED_OWNER_EMAIL=owner@workmeta.ai
SEED_OWNER_PASSWORD=

# Observability (optional)
SENTRY_DSN=
